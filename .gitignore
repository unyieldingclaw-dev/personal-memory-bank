# OS files
.DS_Store
Thumbs.db

# IDE files
.idea/
.vscode/
*.swp
*.swo

# Local Claude Code permissions & secrets — never commit
.claude/settings.local.json

# Credential files — never commit
.env
.env.*
*.pem
*.key
id_rsa
id_ed25519
credentials.json

# Superpowers brainstorming sessions
.superpowers/

# Session handoff notes — ephemeral, consumed by next conversation then deleted
handoff.md

# PMB runtime state files — local-only, not version-controlled
.pmb-checksums
.pmb-delegation-depth
.pmb-hook-errors.log

# Review gate markers — single-use, diff-hash-bound tokens written by /code-review and
# /change-review, consumed by review-reminders.ps1/.sh on the next git commit/push
.claude/.code-review-ok
.claude/.change-review-ok
.claude/.code-review-ok.claimed*
.claude/.change-review-ok.claimed*
.claude/.pending-commit-presha
.claude/.pending-push-presha
.claude/.pending-commit-hash
.claude/.pending-push-hash

# Task contract files — session artifacts, never committed
.claude/contracts/*.json

# Claude Code session worktrees — managed by the harness, not project files
.claude/worktrees/

# Local test files
test-project/
temp/

# Logs
*.log

# Office app lock files (PowerPoint, Word, Excel leave these when files are open)
~$*.pptx
~$*.docx
~$*.xlsx

# AI-generated scratch planning/session state
.claude/plans/
.memory-bank/state/
